        </mxCell>
        <mxCell id="service" value="Service layer&#10;(IncidentService, status state machine,&#10;timeline policy, DiagnosisService)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="850" y="260" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="repo" value="Repository layer&#10;(single-table + GSI1,&#10;atomic ID + append-only timeline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="850" y="360" width="200" height="80" as="geometry" />
