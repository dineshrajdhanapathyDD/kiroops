        <mxCell id="apilayer" value="API layer&#10;(routers, request/response models,&#10;error envelope 422/404/409/503)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
