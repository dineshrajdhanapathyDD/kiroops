          <mxGeometry x="1080" y="210" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="MCP Server (4 tools)&#10;logs, metrics, history, runbook&#10;(seeded simulated data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
